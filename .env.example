# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/aiinfluencer
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
ELEVENLABS_MODEL=eleven_multilingual_v2

# Video Renderer Configuration
VIDEO_RENDERER_API_URL=https://your-video-renderer-api.com
VIDEO_RENDERER_WEBHOOK_SECRET=your-webhook-secret-here

# AWS Configuration
AWS_S3_BUCKET=ai-influencer-videos
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Security
JWT_SECRET=your-jwt-secret-at-least-256-bits

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Application
PORT=8080
LOG_LEVEL=INFO
